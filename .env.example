# ==============================================================================
# ESPACE ADMINISTRATION (AUTHENTIFICATION)
# ==============================================================================
# Adresse e-mail de l'administrateur
ADMIN_EMAIL=admin@digit-talent.com

# Hash bcrypt du mot de passe admin (généré via: node scripts/hash-password.mjs votre_mot_de_passe)
# Mot de passe par défaut ci-dessous: admin123
ADMIN_PASSWORD_HASH="$2b$10$22b.NpF6GiB1Tcs8.AL/s.ikt7MGnzh290U8EEXMhHzbTD9oQBNym"

# Clé secrète pour signer les jetons de session admin
SESSION_SECRET="dt-super-secret-key-change-this-in-production-2026"

# ==============================================================================
# BASE DE DONNÉES SUPABASE (POUR LES CONTENUS ET STATS)
# ==============================================================================
# URL de votre projet Supabase (ex: https://xyzcompany.supabase.co)
SUPABASE_URL=https://votre-projet.supabase.co

# Clé de rôle de service (Service Role Key) trouvée dans Project Settings > API
SUPABASE_SERVICE_ROLE_KEY=votre_service_role_key_supabase

# ==============================================================================
# ENVOI D'EMAILS / CONTACT : BREVO API (ex-Sendinblue)
# ==============================================================================
# Générez votre clé d'API Brevo v3 sur : https://app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Adresse d'expéditeur validée dans votre compte Brevo
BREVO_SENDER_EMAIL=contact@digit-talent.com
BREVO_SENDER_NAME="DIGIT & TALENT"

# Adresse e-mail qui recevra les soumissions de formulaire
CONTACT_RECIPIENT_EMAIL=contact@digit-talent.com
